---
/**
 * Logo: símbolo vectorizado (redibujado del logo original) + logotipo tipográfico
 * PROVISIONAL. Reemplazar el logotipo por el archivo caligráfico real "el guardián"
 * cuando esté disponible.
 */
interface Props { tone?: 'dark' | 'light'; size?: number; }
const { tone = 'dark', size = 42 } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`]} style={`--s:${size}px`}>
  <svg class="logo__mark" viewBox="181 7 710 710" aria-hidden="true">
    <circle cx="536" cy="362" r="355" />
    <path d="M381 336C392 334 404 322 405 322C419 322 424 330 430 340C433 345 436 346 440 342C470 302 517 252 566 218C534 261 489 310 488 345C479 412 554 444 691 507C590 476 500 440 457 410C422 388 410 369 402 345C396 341 389 338 381 336Z" />
  </svg>
  <span class="logo__type">
    <span class="logo__name">El Guardián</span>
    <span class="logo__sub">del Centeno</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; line-height: 1; }
  .logo__mark { width: var(--s); height: var(--s); flex: none; }
  .logo__mark circle { fill: var(--brown); transition: fill .4s; }
  .logo__mark path { fill: var(--cream); }
  .logo__type { display: flex; flex-direction: column; gap: 3px; }
  .logo__name { font-family: var(--f-serif); font-style: italic; font-size: calc(var(--s) * .52); color: var(--brown); }
  .logo__sub { font-size: calc(var(--s) * .22); font-weight: 600; letter-spacing: .32em; text-transform: uppercase; color: var(--caramel-d); padding-left: 1px; }
  .logo--light .logo__mark circle { fill: var(--cream); }
  .logo--light .logo__mark path { fill: var(--choco); }
  .logo--light .logo__name { color: var(--cream); }
  .logo--light .logo__sub { color: var(--beige); }
</style>
