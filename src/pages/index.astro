---
/* MAQUETA — Etapa 2 (branding y dirección visual). */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { negocio, condiciones } from '../config/negocio';
import { categorias, productos, fotos } from '../data/catalogo';

const ars = (n: number) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);
const nav = [
  ['Productos', '#productos'], ['Para tu negocio', '#negocios'], ['Filosofía', '#filosofia'],
  ['Cómo pedir', '#como-pedir'], ['Envíos', '#envios'], ['Preguntas', '#faq'],
];
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>`;
const faqs = [
  ['¿Cómo hago un pedido?', 'Elegís los productos en el catálogo, completás los datos de tu negocio y enviás el pedido por WhatsApp. Te respondemos para confirmar disponibilidad, entrega y forma de pago.', false],
  ['¿Cuál es el pedido mínimo?', `El mínimo por entrega es de ${ars(condiciones.minimoCompra)}.`, true],
  ['¿A qué zonas realizan entregas?', 'Alta Gracia y zonas cercanas.', true],
  ['¿Qué medios de pago aceptan?', 'Se confirma junto con el pedido.', true],
];
---
<Base
  title="El Guardián del Centeno · Panificados artesanales para tu negocio · Alta Gracia"
  description="Medialunas, laminados y panificados de masa madre elaborados artesanalmente en Alta Gracia, Córdoba. Pedidos para cafeterías y comercios por WhatsApp.">

  <!-- ============ HEADER ============ -->
  <header class="hdr" id="top">
    <div class="wrap hdr__in">
      <a href="#top" class="hdr__logo" aria-label="El Guardián del Centeno, inicio"><Logo size={44} /></a>
      <nav class="hdr__nav" aria-label="Principal">
        {nav.map(([t, h]) => <a href={h}>{t}</a>)}
      </nav>
      <div class="hdr__act">
        <button class="cart-btn" data-open-cart aria-label="Ver pedido">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          <span class="cart-btn__txt">Pedido</span>
          <span class="cart-btn__n" data-cart-count>0</span>
        </button>
        <a href="#productos" class="btn hdr__cta">Explorar productos</a>
        <button class="burger" aria-label="Abrir menú" aria-expanded="false" data-burger><span></span><span></span></button>
      </div>
    </div>
    <nav class="mnav" data-mnav aria-label="Menú móvil">
      {nav.map(([t, h]) => <a href={h}>{t}</a>)}
      <a href="#productos" class="btn">Explorar productos</a>
    </nav>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <svg class="hero__bird" viewBox="376 213 320 300" aria-hidden="true"><path d="M381 336C392 334 404 322 405 322C419 322 424 330 430 340C433 345 436 346 440 342C470 302 517 252 566 218C534 261 489 310 488 345C479 412 554 444 691 507C590 476 500 440 457 410C422 388 410 369 402 345C396 341 389 338 381 336Z"/></svg>
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">Panificados artesanales · {negocio.ubicacion}</span>
          <h1>El arte de hacer <em class="acc">buen pan.</em></h1>
          <p class="hero__lead">Panificados artesanales, masa madre y laminados elaborados con tiempo, dedicación e ingredientes seleccionados. Para cafeterías, almacenes y comercios que quieren ofrecer algo distinto.</p>
          <div class="hero__ctas">
            <a href="#productos" class="btn">Explorar productos <Fragment set:html={arrow} /></a>
            <a href="#como-pedir" class="btn btn--ghost">Hacer un pedido</a>
          </div>
          <p class="hero__sign"><span></span>Hecho con tiempo. Disfrutado sin apuro.</p>
        </div>
        <figure class="hero__media">
          <div class="hero__frame">
            <img src={fotos.hero} alt="Medialunas recién horneadas espolvoreadas con harina" width="1400" height="1750" fetchpriority="high" />
            <span class="photo-tag">Foto provisional</span>
          </div>
          <figcaption class="hero__card">
            <span class="label-bold">Medialunas</span>
            <span>90 gr · Masa madre · Harinas seleccionadas</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ CINTA ============ -->
    <div class="ribbon" aria-hidden="true">
      <div class="ribbon__track">
        {[0, 1].map(() => (
          <span>Masa madre <i></i> Laminados <i></i> Medialunas <i></i> Pan de chocolate <i></i> Harinas seleccionadas <i></i> Hecho a mano <i></i></span>
        ))}
      </div>
    </div>

    <!-- ============ CATEGORÍAS ============ -->
    <section class="sec" id="categorias">
      <div class="wrap">
        <div class="sec__head reveal">
          <span class="eyebrow">La vidriera</span>
          <h2>Lo que sale <em class="acc">de nuestro horno</em></h2>
          <p class="sec__intro">Seis familias de productos, una misma manera de hacer las cosas.</p>
        </div>
        <div class="cats">
          {categorias.map((c, i) => (
            <a href="#productos" class="cat reveal" data-goto-cat={c.id} style={`transition-delay:${(i % 3) * 90}ms`}>
              <div class="cat__img">
                <img src={c.img} alt="" loading="lazy" width="900" height="1125" />
                <span class="photo-tag">Foto provisional</span>
              </div>
              <div class="cat__body">
                <span class="cat__n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.nombre}</h3>
                <p>{c.desc}</p>
                <span class="link-arrow">Ver productos <Fragment set:html={arrow} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CATÁLOGO (muestra) ============ -->
    <section class="sec sec--cream" id="productos">
      <div class="wrap">
        <div class="cat-head reveal">
          <div>
            <span class="eyebrow">Catálogo</span>
            <h2>Armá tu <em class="acc">pedido</em></h2>
          </div>
          <label class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
            <span class="sr-only">Buscar productos</span>
            <input type="search" placeholder="Buscar productos" data-search />
          </label>
        </div>
        <div class="chips" role="group" aria-label="Filtrar por categoría">
          <button class="chip is-on" data-filter="todas">Todas</button>
          {categorias.map((c) => <button class="chip" data-filter={c.id}>{c.nombre}</button>)}
        </div>
        <div class="grid" data-grid>
          {productos.map((p) => (
            <article class="prod" data-cat={p.categoria} data-name={p.nombre.toLowerCase()}>
              <div class="prod__img">
                <img src={p.img} alt={p.nombre} loading="lazy" width="700" height="700" />
                {!p.disponible && <span class="prod__out">Sin stock</span>}
                <span class="photo-tag">Foto provisional</span>
              </div>
              <div class="prod__body">
                <span class="prod__cat">{categorias.find((c) => c.id === p.categoria)?.nombre}</span>
                <h3>{p.nombre}</h3>
                <p class="prod__desc">{p.desc}{p.peso && <> · <strong>{p.peso}</strong></>}</p>
                {p.variantes.length > 0 && (
                  <div class="prod__var" role="radiogroup" aria-label="Presentación">
                    {p.variantes.map((v, i) => <button class:list={['var', { 'is-on': i === 0 }]} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>{v}</button>)}
                  </div>
                )}
                <div class="prod__price">
                  <span class="price">{ars(p.precio)}</span>
                  <span class="unit">{p.unidad}</span>
                  {p.demo && <span class="tbc">Precio de ejemplo</span>}
                </div>
                <div class="prod__buy">
                  <div class="qty">
                    <button aria-label="Restar" data-qty="-1">−</button>
                    <input type="number" value="1" min="1" aria-label="Cantidad" />
                    <button aria-label="Sumar" data-qty="1">+</button>
                  </div>
                  <button class="btn btn--caramel prod__add" data-add={p.id} data-price={p.precio} data-name={p.nombre} disabled={!p.disponible}>
                    {p.disponible ? 'Agregar' : 'No disponible'}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="empty" data-empty hidden>No encontramos productos con ese filtro.</p>
      </div>
    </section>

    <!-- ============ PARA TU NEGOCIO ============ -->
    <section class="biz" id="negocios">
      <div class="biz__media reveal">
        <img src={fotos.negocio} alt="Vitrina con medialunas" loading="lazy" width="1200" height="900" />
        <span class="photo-tag">Foto provisional</span>
      </div>
      <div class="biz__copy reveal">
        <span class="eyebrow eyebrow--light">Para tu negocio</span>
        <h2>Tu vitrina, con <em class="acc">pan de autor</em></h2>
        <p>Elaboramos para cafeterías, almacenes, dietéticas y comercios de la zona que quieren ofrecer productos artesanales de verdad.</p>
        <ul class="biz__list">
          <li><span>01</span>Elaboración artesanal con masa madre</li>
          <li><span>02</span>Pedidos simples por WhatsApp</li>
          <li><span>03</span>Entregas coordinadas en Alta Gracia <span class="tbc tbc--light">Zonas a confirmar</span></li>
        </ul>
        <a href="#como-pedir" class="btn btn--light">Quiero vender en mi negocio <Fragment set:html={arrow} /></a>
      </div>
    </section>

    <!-- ============ FILOSOFÍA ============ -->
    <section class="sec phil" id="filosofia">
      <div class="wrap phil__grid">
        <div class="phil__imgs reveal">
          <div class="phil__a"><img src={fotos.manos} alt="Manos sosteniendo un bollo de masa" loading="lazy" width="1000" height="1250" /><span class="photo-tag">Foto provisional</span></div>
          <div class="phil__b"><img src={fotos.harina} alt="Harina espolvoreada sobre la mesa de trabajo" loading="lazy" width="1000" height="1000" /><span class="photo-tag">Foto provisional</span></div>
        </div>
        <div class="phil__copy reveal">
          <span class="eyebrow">Nuestra filosofía</span>
          <blockquote>“Creemos que las cosas buenas <em class="acc">necesitan tiempo.</em>”</blockquote>
          <p>En El Guardián del Centeno, cada elaboración busca respetar el proceso, cuidar los ingredientes y recuperar el placer de disfrutar algo hecho con dedicación.</p>
          <div class="phil__facts">
            <div><span class="label-bold">Masa madre</span><small>Fermentación natural</small></div>
            <div><span class="label-bold">Tiempo</span><small>Procesos sin apuro</small></div>
            <div><span class="label-bold">Selección</span><small>Harinas seleccionadas</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CÓMO PEDIR ============ -->
    <section class="sec sec--choco" id="como-pedir">
      <div class="wrap">
        <div class="sec__head sec__head--center reveal">
          <span class="eyebrow eyebrow--light">Cómo pedir</span>
          <h2>Cuatro pasos, <em class="acc">sin vueltas</em></h2>
        </div>
        <ol class="steps">
          {[
            ['Explorá el catálogo', 'Mirá productos, presentaciones y precios.'],
            ['Armá tu pedido', 'Agregá cantidades y revisá el mínimo de compra.'],
            ['Completá tus datos', 'Negocio, dirección y fecha de entrega deseada.'],
            ['Envialo por WhatsApp', 'Te respondemos para confirmar disponibilidad y entrega.'],
          ].map(([t, d], i) => (
            <li class="reveal" style={`transition-delay:${i * 90}ms`}>
              <span class="steps__n">{i + 1}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ ENVÍOS ============ -->
    <section class="sec" id="envios">
      <div class="wrap ship">
        <div class="ship__copy reveal">
          <span class="eyebrow">Envíos y entregas</span>
          <h2>Antes de pedir, <em class="acc">lo importante</em></h2>
          <p>Las condiciones de entrega se confirman por WhatsApp junto con cada pedido. Ningún envío está confirmado hasta que te respondemos.</p>
          {!condiciones.confirmado && <p class="ship__warn"><span class="tbc">Valores de ejemplo</span> Condiciones pendientes de confirmar por el negocio.</p>}
        </div>
        <div class="ship__tiles">
          <div class="tile reveal"><span class="tile__k">Pedido mínimo</span><span class="tile__v">{ars(condiciones.minimoCompra)}</span><span class="tile__d">por entrega</span></div>
          <div class="tile reveal"><span class="tile__k">Zona</span><span class="tile__v">Alta Gracia</span><span class="tile__d">y alrededores, a consultar</span></div>
          <div class="tile reveal"><span class="tile__k">Costo de envío</span><span class="tile__v">Según zona</span><span class="tile__d">se confirma por WhatsApp</span></div>
          <div class="tile reveal"><span class="tile__k">Anticipación</span><span class="tile__v">A confirmar</span><span class="tile__d">días y horarios de entrega</span></div>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="sec sec--cream" id="faq">
      <div class="wrap faq">
        <div class="reveal">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2>Lo que <em class="acc">suelen preguntarnos</em></h2>
        </div>
        <div class="acc-list">
          {faqs.map(([q, a, tbc]) => (
            <details class="acc-item">
              <summary>{q}<span class="acc-item__ico" aria-hidden="true"></span></summary>
              <p>{a} {tbc && <span class="tbc">A confirmar</span>}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="ftr">
    <div class="wrap ftr__grid">
      <div class="ftr__brand">
        <Logo tone="light" size={56} />
        <p>Panificados artesanales, masa madre y laminados. Elaborados en {negocio.ubicacion} para comercios de la zona.</p>
      </div>
      <div>
        <h4>Productos</h4>
        {categorias.slice(0, 5).map((c) => <a href="#productos">{c.nombre}</a>)}
      </div>
      <div>
        <h4>Información</h4>
        <a href="#como-pedir">Cómo pedir</a><a href="#envios">Envíos y entregas</a><a href="#faq">Preguntas frecuentes</a>
      </div>
      <div>
        <h4>Contacto</h4>
        <a href={negocio.instagram.url} target="_blank" rel="noopener">@{negocio.instagram.usuario}</a>
        <span>{negocio.ubicacion}</span>
        <span class="ftr__note">Venta por pedido. Sin atención al público.</span>
      </div>
    </div>
    <div class="wrap ftr__bottom"><span>© {new Date().getFullYear()} {negocio.nombre}</span><span>Hecho con tiempo.</span></div>
  </footer>

  <!-- ============ WHATSAPP FLOTANTE ============ -->
  <a class="wa" href="#como-pedir" aria-label="Pedir por WhatsApp" data-wa>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/></svg>
  </a>

  <!-- ============ CARRITO (vista previa) ============ -->
  <div class="drawer" data-drawer aria-hidden="true">
    <div class="drawer__bg" data-close-cart></div>
    <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="Tu pedido">
      <div class="drawer__head">
        <h3>Tu pedido</h3>
        <button class="drawer__x" data-close-cart aria-label="Cerrar">×</button>
      </div>
      <div class="drawer__min">
        <div class="drawer__min-row"><span data-min-msg>Te faltan {ars(condiciones.minimoCompra)} para el mínimo</span><span class="tbc">Ejemplo</span></div>
        <div class="bar"><span data-bar style="width:0%"></span></div>
      </div>
      <ul class="lines" data-lines><li class="lines__empty">Todavía no agregaste productos.</li></ul>
      <div class="drawer__foot">
        <div class="sum"><span>Subtotal</span><strong data-sub>{ars(0)}</strong></div>
        <div class="sum sum--muted"><span>Envío</span><span>Se confirma por WhatsApp</span></div>
        <button class="btn" disabled data-checkout>Completar datos de entrega</button>
        <button class="link-arrow drawer__keep" data-close-cart>Seguir comprando</button>
      </div>
    </aside>
  </div>
</Base>

<script define:vars={{ MIN: condiciones.minimoCompra }}>
  const fmt = (n) => new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  // Header al hacer scroll
  const hdr = $('.hdr');
  const onScroll = () => hdr.classList.toggle('is-solid', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // Menú móvil
  const burger = $('[data-burger]');
  burger.addEventListener('click', () => {
    const open = hdr.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
  });
  $$('[data-mnav] a').forEach((a) => a.addEventListener('click', () => { hdr.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); }));

  // Filtros y búsqueda
  let cat = 'todas', q = '';
  const apply = () => {
    let n = 0;
    $$('.prod').forEach((p) => {
      const ok = (cat === 'todas' || p.dataset.cat === cat) && p.dataset.name.includes(q);
      p.hidden = !ok; if (ok) n++;
    });
    $('[data-empty]').hidden = n > 0;
  };
  const setCat = (c) => { cat = c; $$('.chip').forEach((b) => b.classList.toggle('is-on', b.dataset.filter === c)); apply(); };
  $$('.chip').forEach((b) => b.addEventListener('click', () => setCat(b.dataset.filter)));
  $$('[data-goto-cat]').forEach((a) => a.addEventListener('click', () => setCat(a.dataset.gotoCat)));
  $('[data-search]').addEventListener('input', (e) => { q = e.target.value.trim().toLowerCase(); apply(); });

  // Variantes y cantidades
  $$('.prod__var').forEach((g) => g.addEventListener('click', (e) => {
    const b = e.target.closest('.var'); if (!b) return;
    $$('.var', g).forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-checked', String(x === b)); });
  }));
  $$('.qty').forEach((w) => w.addEventListener('click', (e) => {
    const b = e.target.closest('[data-qty]'); if (!b) return;
    const i = $('input', w); i.value = Math.max(1, (+i.value || 1) + +b.dataset.qty);
  }));

  // Carrito (vista previa de la maqueta, sin persistencia)
  const cart = new Map();
  const drawer = $('[data-drawer]');
  const open = () => { drawer.classList.add('is-open'); drawer.setAttribute('aria-hidden', 'false'); };
  const close = () => { drawer.classList.remove('is-open'); drawer.setAttribute('aria-hidden', 'true'); };
  $$('[data-open-cart]').forEach((b) => b.addEventListener('click', open));
  $$('[data-close-cart]').forEach((b) => b.addEventListener('click', close));
  addEventListener('keydown', (e) => e.key === 'Escape' && close());

  const render = () => {
    let sub = 0, units = 0;
    const ul = $('[data-lines]'); ul.innerHTML = '';
    cart.forEach((l, k) => {
      sub += l.price * l.qty; units += l.qty;
      const li = document.createElement('li');
      li.innerHTML = `<div><strong>${l.name}</strong><small>${l.variant ? l.variant + ' · ' : ''}${fmt(l.price)} c/u</small></div>
        <div class="qty qty--sm"><button data-d="-1" aria-label="Restar">−</button><span>${l.qty}</span><button data-d="1" aria-label="Sumar">+</button></div>
        <span class="lines__t">${fmt(l.price * l.qty)}</span><button class="lines__rm" aria-label="Quitar">Quitar</button>`;
      li.querySelector('.qty').addEventListener('click', (e) => { const b = e.target.closest('[data-d]'); if (!b) return; l.qty = Math.max(1, l.qty + +b.dataset.d); render(); });
      li.querySelector('.lines__rm').addEventListener('click', () => { cart.delete(k); render(); });
      ul.append(li);
    });
    if (!cart.size) ul.innerHTML = '<li class="lines__empty">Todavía no agregaste productos.</li>';
    $('[data-sub]').textContent = fmt(sub);
    $('[data-cart-count]').textContent = units;
    const pct = Math.min(100, (sub / MIN) * 100);
    $('[data-bar]').style.width = pct + '%';
    $('[data-min-msg]').textContent = sub >= MIN ? 'Alcanzaste el pedido mínimo' : `Te faltan ${fmt(MIN - sub)} para el mínimo`;
    $('[data-checkout]').disabled = sub < MIN;
  };

  $$('[data-add]').forEach((b) => b.addEventListener('click', () => {
    const card = b.closest('.prod');
    const qty = +$('.qty input', card).value || 1;
    const variant = $('.var.is-on', card)?.textContent || '';
    const key = b.dataset.add + '|' + variant;
    const l = cart.get(key) || { name: b.dataset.name, price: +b.dataset.price, variant, qty: 0 };
    l.qty += qty; cart.set(key, l); render();
    $('.cart-btn').classList.remove('bump'); void $('.cart-btn').offsetWidth; $('.cart-btn').classList.add('bump');
    b.textContent = 'Agregado'; setTimeout(() => (b.textContent = 'Agregar'), 1200);
  }));
</script>

<style is:global>
  /* ---------- Header ---------- */
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; transition: background .4s var(--ease), box-shadow .4s var(--ease); }
  .hdr.is-solid { background: rgba(250, 247, 240, .94); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 84px; transition: height .4s var(--ease); }
  .hdr.is-solid .hdr__in { height: 70px; }
